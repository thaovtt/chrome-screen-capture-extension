{
  "manifest_version": 3,
  "name": "Screen Capture & Recorder",
  "version": "1.0.0",
  "description": "Capture visible tabs, selected areas, full page screenshots, and record screen video.",
  "permissions": [
    "activeTab",
    "storage",
    "offscreen",
    "scripting",
    "downloads",
    "desktopCapture",
    "tabCapture"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "public/icons/icon-16.png",
    "48": "public/icons/icon-48.png",
    "128": "public/icons/icon-128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Screen Capture & Recorder",
    "default_icon": {
      "16": "public/icons/icon-16.png",
      "48": "public/icons/icon-48.png",
      "128": "public/icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/index.ts"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/offscreen/offscreen.html",
        "src/editor/editor.html",
        "public/icons/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
